generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — Existing
// ============================================================
enum OtpPurpose {
  Registration
  PasswordReset
  EmailChange
}

// ============================================================
// Enums — Smartphone Recommendation System
// ============================================================
enum CameraPreference {
  Sensible
  Photophile
  SelfieAddict @map("Selfie-Addict")
}

enum UsageType {
  Student
  Gamer
  Business
  Casual
  Creator
}

enum BudgetSegment {
  BudgetExplorer  @map("Budget Explorer")
  AffordableBuyer @map("Affordable Buyer")
  MidRangeBuyer   @map("Mid Range Buyer")
  PremiumBuyer    @map("Premium Buyer")
  LuxuryBuyer     @map("Luxury Buyer")
}

enum TechTier {
  Budget
  Reasonable
  FlagshipKiller @map("Flagship Killer")
  TechSavvy      @map("Tech Savvy")
  Luxurious
}

enum SegmentConfidence {
  provisional
  confirmed
}

// ============================================================
// Models — Auth / RBAC / Sessions
// ============================================================
model Roles {
  roleId   String  @id @default(uuid()) @map("role_id") @db.Uuid
  roleName String  @unique @map("role_name") @db.VarChar(50)
  users    Users[]

  @@map("roles")
}

model Users {
  name       String
  userId     String  @id @default(uuid()) @map("user_id") @db.Uuid
  email      String  @unique @db.VarChar(255)
  password   String  @db.VarChar(255)
  phoneNo    String? @unique @map("phone_no")
  isActive   Boolean @default(true) @map("is_active")
  isVerified Boolean @default(false) @map("is_verified")

  roleId String? @map("role_id") @db.Uuid
  role   Roles?  @relation(fields: [roleId], references: [roleId], onDelete: SetNull)

  otps Otp[]

  // Smartphone recommendation system relations
  profile               UserProfile?
  preference            UserPreference?
  customerProfile       CustomerProfile?
  recommendationHistory RecommendationHistory[]
  wishlist              Wishlist[]
  comparisonHistory     ComparisonHistory[]
  paymentHistory        PaymentHistory[]
  searchHistory         SearchHistory[]
  browsingHistory       BrowsingHistory[]

  // Step B — unified behaviour event log + per-tag behaviour score
  events         Event[]
  behaviorScores BehaviorScore[]

  // Step D — per-candidate impression log for the new fused ranker.
  // Feeds future customer-segmentation clustering (the popularity
  // signal reserved at 0.05 weight in FUSION_WEIGHTS).
  recommendationLogs RecommendationLog[]

  @@index([roleId])
  @@map("users")
}

model Otp {
  otpId     String     @id @default(uuid()) @map("otp_id") @db.Uuid
  code      String     @db.VarChar(6)
  userId    String     @map("user_id") @db.Uuid
  purpose   OtpPurpose @default(Registration) @map("purpose")
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, purpose, isUsed, expiresAt])
  @@map("otps")
}

model Session {
  sid    String   @id @map("sid") @db.VarChar
  sess   Json     @map("sess")
  expire DateTime @map("expire") @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ============================================================
// Normalized Phone Data Models
// ============================================================

// Brand master table
model Brands {
  brandId   String   @id @default(uuid()) @map("brand_id") @db.Uuid
  name      String   @unique @db.VarChar(60)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  website   String?  @db.VarChar(200)
  country   String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phones          Phones[]
  userPreferences UserPreference[]

  @@map("brands")
}

// Main phone model - each phone model (e.g., "Galaxy S24 Ultra")
model Phones {
  phoneId   String @id @default(uuid()) @map("phone_id") @db.Uuid
  brandId   String @map("brand_id") @db.Uuid
  modelName String @map("model_name") @db.VarChar(120)

  // Display image
  imageUrl  String? @map("image_url") @db.VarChar(500)
  imagePath String? @map("image_path") @db.VarChar(500)

  // Aggregated/derived fields for quick filtering
  antutuScore Int? @map("antutu_score") // Best score across all variants
  batteryMah  Int? @map("battery_mah") // From specs

  // Data provenance
  source    String? @db.VarChar(40) // e.g., "gsmarena", "admin", "api"
  sourceUrl String? @map("source_url") @db.VarChar(500) // Original page URL

  // Soft delete & lifecycle
  isActive       Boolean   @default(true) @map("is_active")
  discontinuedAt DateTime? @map("discontinued_at")
  createdAt      DateTime  @default(now()) @map("created_date")
  updatedAt      DateTime  @updatedAt @map("updated_date")

  // Relations
  brand    Brands          @relation(fields: [brandId], references: [brandId], onDelete: Cascade)
  variants PhoneVariants[]
  specs    PhoneSpecs?

  // Recommendation relations
  recommendationHistory RecommendationHistory[]
  recommendationLogs     RecommendationLog[]
  wishlist              Wishlist[]
  comparedAsA           ComparisonHistory[]     @relation("ComparisonPhoneA")
  comparedAsB           ComparisonHistory[]     @relation("ComparisonPhoneB")

  // Admin stats cache back-relations (cache stores phoneId; relations are
  // nullable so hard-deletion of a phone does not cascade into historical
  // cache rows).
  mostRecommendedInStats AdminStatsCache[] @relation("MostRecommendedPhone")
  mostComparedInStats    AdminStatsCache[] @relation("MostComparedPhone")
  mostViewedInStats      AdminStatsCache[] @relation("MostViewedPhone")

  @@unique([brandId, modelName])
  @@index([brandId])
  @@index([antutuScore])
  @@index([isActive])
  @@map("phones")
}

// Phone variants - different RAM/Storage/Price combinations for each phone
model PhoneVariants {
  variantId String @id @default(uuid()) @map("variant_id") @db.Uuid
  phoneId   String @map("phone_id") @db.Uuid

  // Specifications that vary by variant
  ramGb       Int      @map("ram_gb")
  storageGb   Int      @map("storage_gb")
  price       Decimal? @db.Decimal(10, 2)
  storageType String?  @map("storage_type") @db.VarChar(20) // e.g., "UFS 3.1"

  // Color options (could be JSON array or separate table)
  colors Json? @db.Json // e.g., ["Black", "White", "Blue"]

  // Availability
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phone Phones @relation(fields: [phoneId], references: [phoneId], onDelete: Cascade)

  @@unique([phoneId, ramGb, storageGb])
  @@index([phoneId])
  @@index([price])
  @@map("phone_variants")
}

// Detailed phone specifications (1-to-1 with Phones)
model PhoneSpecs {
  specId  String @id @default(uuid()) @map("spec_id") @db.Uuid
  phoneId String @unique @map("phone_id") @db.Uuid

  // Network & Connectivity
  networkTech   String?  @map("network_technology") @db.VarChar(100)
  supports5g    Boolean  @default(false) @map("supports_5g")
  supportsNfc   Boolean  @default(false) @map("supports_nfc")
  dualSim       Boolean  @default(false) @map("dual_sim")
  simType       String?  @map("sim_type") @db.VarChar(50)
  wifi          String?  @db.VarChar(100)
  bluetooth     String?  @map("bluetooth_version") @db.VarChar(20)
  usbType       String?  @map("usb_type") @db.VarChar(50)
  headphoneJack Boolean? @map("headphone_jack")
  gps           Boolean  @default(true)
  sensors       Json?    @db.Json // Array of sensors: ["Accelerometer", "Gyro", "Proximity"]

  // Display
  displayType       String?  @map("display_type") @db.VarChar(50)
  refreshRate       Int?     @map("refresh_rate_hz")
  displaySize       Decimal? @map("display_size_inch") @db.Decimal(4, 2)
  resolution        String?  @db.VarChar(30) // e.g., "1080x2400"
  ppiDensity        Int?     @map("ppi_density")
  screenToBody      Decimal? @map("screen_to_body_pct") @db.Decimal(5, 2)
  displayProtection String?  @map("display_protection") @db.VarChar(100)

  // Platform
  os          String? @db.VarChar(40)
  osVersion   String? @map("os_version") @db.VarChar(40)
  chipset     String? @db.VarChar(100)
  processNode String? @map("process_node_nm") @db.VarChar(20) // e.g., "4nm"
  cpu         String? @db.VarChar(200)
  gpu         String? @db.VarChar(200)

  // Camera
  mainCamera   String?  @map("main_camera_mp") @db.VarChar(50) // "50MP + 12MP + 8MP"
  lensCount    Int?     @map("lens_count")
  mainAperture String?  @map("main_aperture") @db.VarChar(20)
  ois          Boolean? @default(false)
  sensorSize   String?  @map("sensor_size") @db.VarChar(50)
  camera4K     Boolean? @map("camera_4k_video")
  cameraVideo  String?  @map("camera_video") @db.VarChar(200)
  selfieCamera String?  @map("selfie_camera_mp") @db.VarChar(50)
  selfie4K     Boolean? @map("selfie_4k_video")

  // Physical
  dimensions    String?  @db.VarChar(100) // "163.2 x 76.8 x 8.6"
  weight        Decimal? @db.Decimal(6, 2)
  buildMaterial String?  @map("build_material") @db.VarChar(100) // e.g., "Glass front, aluminum frame"
  ipRating      String?  @map("ip_rating") @db.VarChar(10) // e.g., "IP68"

  // Battery
  batteryMah       Int?     @map("battery_mah")
  wiredCharging    Int?     @map("wired_charging_w")
  wirelessCharging Int?     @map("wireless_charging_w")
  reverseWireless  Boolean? @map("reverse_wireless_charging")

  // Metadata
  announced DateTime? @db.Date
  status    String?   @db.VarChar(50) // "Available", "Discontinued", "Upcoming"

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phone Phones @relation(fields: [phoneId], references: [phoneId], onDelete: Cascade)

  @@index([supports5g])
  @@index([os])
  @@map("phone_specs")
}

// ============================================================
// User Profile & Preferences
// ============================================================

model UserProfile {
  profileId String   @id @default(uuid()) @map("profile_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  age       Int?     @db.SmallInt
  gender    String?  @db.VarChar(20)
  country   String?  @db.VarChar(80)
  state     String?  @db.VarChar(80)
  city      String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  preferenceId String @id @default(uuid()) @map("preference_id") @db.Uuid
  userId       String @unique @map("user_id") @db.Uuid

  maxBudget        Decimal          @map("max_budget") @db.Decimal(10, 2)
  cameraPreference CameraPreference @map("camera_preference")
  usageType        UsageType        @map("usage_type")

  // FK to Brands. Nullable so a user can submit the questionnaire before the
  // Brands table is fully seeded, or skip the brand question. The questionnaire
  // UI is responsible for not submitting a brand name that isn't in `Brands`.
  preferredBrandId String? @map("preferred_brand_id") @db.Uuid
  preferredBrand   Brands? @relation(fields: [preferredBrandId], references: [brandId], onDelete: SetNull)

  // Multiple preferred brand names accumulated from CSV imports or
  // questionnaire iterations. Stored as a JSON array of unique strings
  // (e.g. ["Apple", "Samsung", "Google"]). `preferredBrandId` above
  // remains the FK-resolution for the primary brand; this list preserves
  // the full set.
  preferredBrands Json? @map("preferred_brands") @db.JsonB

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([preferredBrandId])
  @@map("user_preferences")
}

// ============================================================
// Recommendation & Analytics
// ============================================================

model RecommendationHistory {
  historyId  String   @id @default(uuid()) @map("history_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneId    String   @map("phone_id") @db.Uuid
  searchDate DateTime @default(now()) @map("search_date")

  queryId     String? @map("query_id") @db.Uuid
  filtersJson Json?   @map("filters_json")

  performanceMatch     Decimal? @map("performance_match") @db.Decimal(5, 2)
  cameraMatch          Decimal? @map("camera_match") @db.Decimal(5, 2)
  batteryMatch         Decimal? @map("battery_match") @db.Decimal(5, 2)
  displayMatch         Decimal? @map("display_match") @db.Decimal(5, 2)
  budgetMatch          Decimal? @map("budget_match") @db.Decimal(5, 2)
  brandMatch           Decimal? @map("brand_match") @db.Decimal(5, 2)
  overallCompatibility Decimal? @map("overall_compatibility") @db.Decimal(5, 2)

  personaSnapshot String? @map("persona_snapshot") @db.VarChar(60)

  clicked   Boolean @default(false)
  compared  Boolean @default(false)
  saved     Boolean @default(false)
  purchased Boolean @default(false)

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  @@index([userId, searchDate(sort: Desc)])
  @@index([phoneId])
  @@index([queryId])
  @@map("recommendation_history")
}

// Step D — per-candidate impression log. One row per served candidate
// (rank + finalScore + userId + phoneId). Feeds the future customer-
// segmentation cluster that will reclaim the 0.05 popularity slot
// currently held open in FUSION_WEIGHTS. Click-through tracking is
// not on this table — `clicked` here is reserved for a future
// analytics job; today it's seeded false and never written.
model RecommendationLog {
  logId      String   @id @default(uuid()) @map("log_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneId    String   @map("phone_id") @db.Uuid
  finalScore Float    @map("final_score")
  rank       Int
  shownAt    DateTime @default(now()) @map("shown_at")
  clicked    Boolean  @default(false)

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  @@index([userId, shownAt(sort: Desc)])
  @@index([phoneId])
  @@map("recommendation_logs")
}

model CustomerProfile {
  profileId String @id @default(uuid()) @map("profile_id") @db.Uuid
  userId    String @unique @map("user_id") @db.Uuid

  budgetSegment    BudgetSegment?    @map("budget_segment")
  techTier         TechTier?         @map("tech_tier")
  cameraPreference CameraPreference? @map("camera_preference")
  softwareSegment  String?           @map("software_segment") @db.VarChar(40)

  favoriteBrand      String? @map("favorite_brand") @db.VarChar(60)
  preferredRamGb     Int?    @map("preferred_ram_gb")
  preferredStorageGb Int?    @map("preferred_storage_gb")

  recommendationPersona String? @map("recommendation_persona") @db.VarChar(60)

  // Internal running state
  avgPerformanceMatch Decimal? @map("avg_performance_match") @db.Decimal(5, 2)
  avgCameraMatch      Decimal? @map("avg_camera_match") @db.Decimal(5, 2)
  avgFrontCameraMatch Decimal? @map("avg_front_camera_match") @db.Decimal(5, 2)
  avgBudget           Decimal? @map("avg_budget") @db.Decimal(10, 2)
  avgBatteryMatch     Decimal? @map("avg_battery_match") @db.Decimal(5, 2)
  avgDisplayMatch     Decimal? @map("avg_display_match") @db.Decimal(5, 2)

  segmentConfidence SegmentConfidence @default(provisional) @map("segment_confidence")
  searchCount       Int               @default(0) @map("search_count")

  totalRecommendations Int @default(0) @map("total_recommendations")
  totalComparisons     Int @default(0) @map("total_comparisons")
  totalWishlist        Int @default(0) @map("total_wishlist")

  lastUpdated DateTime @updatedAt @map("last_updated")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("customer_profile")
}

model Wishlist {
  wishlistId String   @id @default(uuid()) @map("wishlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneId    String   @map("phone_id") @db.Uuid
  addedDate  DateTime @default(now()) @map("added_date")

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  @@unique([userId, phoneId])
  @@map("wishlist")
}

model ComparisonHistory {
  comparisonId String   @id @default(uuid()) @map("comparison_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  phoneIdA     String   @map("phone_id_a") @db.Uuid
  phoneIdB     String   @map("phone_id_b") @db.Uuid
  comparedDate DateTime @default(now()) @map("compared_date")

  user   Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phoneA Phones @relation("ComparisonPhoneA", fields: [phoneIdA], references: [phoneId])
  phoneB Phones @relation("ComparisonPhoneB", fields: [phoneIdB], references: [phoneId])

  @@index([userId, comparedDate(sort: Desc)])
  @@map("comparison_history")
}

// ============================================================
// Payment History (per-purchase records from CSV imports)
// ============================================================

// One row per purchase event from external data sources
// (e.g. customer_dataset.csv). Not tied to the normalized phone
// catalog by FK — phones referenced here may not exist in the
// catalog. `phoneLabel` preserves the human-readable name as it
// appeared in the source for audit purposes.
model PaymentHistory {
  paymentId         String    @id @default(uuid()) @map("payment_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  purchaseDate      DateTime? @map("purchase_date") @db.Date
  purchaseAmountNpr Decimal?  @map("purchase_amount_npr") @db.Decimal(12, 2)
  paymentMethod     String?   @map("payment_method") @db.VarChar(60)
  warrantyOpted     String?   @map("warranty_opted") @db.VarChar(40)
  exchangeHistory   Json?     @map("exchange_history") @db.JsonB
  phoneLabel        String?   @map("phone_label") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, purchaseDate(sort: Desc)])
  @@index([purchaseDate])
  @@map("payment_history")
}

// ============================================================
// Search History (per-search records from CSV imports)
// ============================================================

// One row per search event from external data sources. Not tied to the
// catalog by FK — `searchQuery` is the raw CSV value, which can be a brand
// name, a category tag, "Comparison", "New Arrivals", etc.
model SearchHistory {
  searchId     String    @id @default(uuid()) @map("search_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  searchQuery  String    @map("search_query") @db.VarChar(200)
  searchedAt   DateTime? @map("searched_at") @db.Timestamp(6)
  sourceLine   Int?      @map("source_line")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
  @@index([searchedAt])
  @@map("search_history")
}

// ============================================================
// Browsing History (per-viewed-item records from CSV imports)
// ============================================================

// One row per viewed item from external data sources. Intentionally NOT
// linked to `Phones` by FK — the source contains fictional / future /
// discontinued / tablet entries that don't exist in the catalog. The raw
// label is preserved verbatim for downstream analytics.
model BrowsingHistory {
  browsingId  String    @id @default(uuid()) @map("browsing_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phoneLabel  String    @map("phone_label") @db.VarChar(200)
  brandName   String?   @map("brand_name") @db.VarChar(60)
  viewedAt    DateTime? @map("viewed_at") @db.Timestamp(6)
  sourceLine  Int?      @map("source_line")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([viewedAt])
  @@map("browsing_history")
}

model AdminStatsCache {
  statId               String   @id @default(uuid()) @map("stat_id") @db.Uuid
  computedDate         DateTime @default(now()) @map("computed_date")
  mostRecommendedBrand String?  @map("most_recommended_brand") @db.VarChar(60)

  // FKs into Phones (nullable — the cache row is "as-of computedDate";
  // the phone may have been hard-removed later, and the cache should still
  // display the historical snapshot).
  mostRecommendedPhoneId String? @map("most_recommended_phone_id") @db.Uuid
  mostComparedPhoneId    String? @map("most_compared_phone_id") @db.Uuid
  mostViewedPhoneId      String? @map("most_viewed_phone_id") @db.Uuid

  avgUserBudget      Decimal? @map("avg_user_budget") @db.Decimal(10, 2)
  mostPopularPersona String?  @map("most_popular_persona") @db.VarChar(60)
  avgCompatibility   Decimal? @map("avg_compatibility") @db.Decimal(5, 2)

  // Relations — back-relation only. The Phone→AdminStatsCache FK is intentionally
  // NOT modeled (admin cache is a denormalized snapshot, not a hot FK). The cache
  // row stores the phoneId; the consumer joins on `Phones.phoneId` at read time.
  mostRecommendedPhone Phones? @relation("MostRecommendedPhone", fields: [mostRecommendedPhoneId], references: [phoneId], onDelete: SetNull)
  mostComparedPhone    Phones? @relation("MostComparedPhone", fields: [mostComparedPhoneId], references: [phoneId], onDelete: SetNull)
  mostViewedPhone      Phones? @relation("MostViewedPhone", fields: [mostViewedPhoneId], references: [phoneId], onDelete: SetNull)

  @@index([computedDate(sort: Desc)])
  @@map("admin_stats_cache")
}

// ============================================================
// Step B — Unified Event Log + Per-Tag Behaviour Scores
// ============================================================
//
// `Event` is the single source of truth for every user interaction. The
// legacy Step A tables (SearchHistory / BrowsingHistory /
// RecommendationHistory / ComparisonHistory) remain so the existing
// admin UI keeps working — controllers write to BOTH (`bridge` pattern).
//
// `BehaviorScore` rolls per-tag deltas from every event into a single
// exponentially-decayed score. Step C (Profile Fusion) and Step D
// (Ranking) will read from this table.

model Event {
  eventId   String   @id @default(uuid()) @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(40) // search | view | compare | click | save | ignore | recommend
  phoneId   String?  @map("phone_id") @db.Uuid
  payload   Json?    @map("payload") // free-form context: {q:"ROG"} | {modelNameA,modelNameB} | {filters:{...}}
  createdAt DateTime @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("events")
}

model BehaviorScore {
  userId    String   @map("user_id") @db.Uuid
  tag       String   @db.VarChar(60) // e.g. "gaming", "camera", "battery", "brand:Samsung", "tier:flagship"
  score     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, tag])
  @@index([userId])
  @@map("behavior_scores")
}

// ============================================================
// Notes:
//
// 1. This schema normalizes phone data into:
//    - Brands: Master brand list
//    - Phones: Each phone model (unique by brand + modelName)
//    - PhoneVariants: RAM/Storage/Price combinations
//    - PhoneSpecs: Detailed specifications (1-to-1 with Phones)
//
// 2. Data Import Example:
//    Insert brand → Insert phone → Insert variants → Insert specs
//
// 3. For filtering by variant attributes (RAM, storage, price):
