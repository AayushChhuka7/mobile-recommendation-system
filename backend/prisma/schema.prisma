generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"

}

enum OtpPurpose {
  Registration
  PasswordReset
  EmailChange
}

model Roles {
  roleId   String  @id @default(uuid()) @map("role_id") @db.Uuid
  roleName String  @unique @map("role_name") @db.VarChar(50)
  users    Users[]

  // RBAC Phase 2: a role is a bundle of permissions via the
  // RolePermissions join. New permissions are insert-only; the matrix
  // is seeded idempotently.
  permissions RolePermissions[]

  @@map("roles")
}

model Permissions {
  permissionId   String   @id @default(uuid()) @map("permission_id") @db.Uuid
  permissionKey  String   @unique @map("permission_key") @db.VarChar(100)
  description    String?  @map("description") @db.VarChar(255)

  roles RolePermissions[]

  @@map("permissions")
}

model RolePermissions {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid

  role       Roles       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Users {
  name      String
  userId    String  @id @default(uuid()) @map("user_id") @db.Uuid
  email     String  @unique @db.VarChar(255)
  password  String  @db.VarChar(255)
  phoneNo   String? @map("phone_no")
  isActive  Boolean @default(true) @map("is_active")
  isVerified Boolean @default(false) @map("is_verified")

  // Phase 1 RBAC: direct FK to Roles. Optional so existing rows can be
  // backfilled by the seed script without a schema-level DEFAULT.
  // (Phase 2 may need to migrate this to a join table when many-roles
  // or role→permission joins land; we'll handle that when we get there.)
  roleId String? @map("role_id") @db.Uuid
  role   Roles?  @relation(fields: [roleId], references: [roleId], onDelete: SetNull)

  otps Otp[]

  @@index([roleId])
  @@map("users")
}

model Otp {
  otpId     String     @id @default(uuid()) @map("otp_id") @db.Uuid
  code      String     @db.VarChar(6)
  userId    String     @map("user_id") @db.Uuid
  purpose   OtpPurpose @default(Registration) @map("purpose")
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  user      Users      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, purpose, isUsed, expiresAt])
  @@map("otps")
}

// Owned by Prisma. Previously connect-pg-simple created this at runtime
// (createTableIfMissing: true) which caused migration-history drift.
// Shape mirrors the columns the library was issuing: sid PK, sess json,
// expire timestamp. The `IDX_session_expire` index is preserved.
model Session {
  sid    String   @id @map("sid") @db.VarChar
  sess   Json     @map("sess")
  expire DateTime @map("expire") @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}