generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — Existing
// ============================================================
enum OtpPurpose {
  Registration
  PasswordReset
  EmailChange
}

// ============================================================
// Enums — Smartphone Recommendation System
// ============================================================
enum CameraPreference {
  Sensible
  Photophile
  SelfieAddict @map("Selfie-Addict")
}

enum UsageType {
  Student
  Gamer
  Business
  Casual
  Creator
}

enum BudgetSegment {
  BudgetExplorer  @map("Budget Explorer")
  AffordableBuyer @map("Affordable Buyer")
  MidRangeBuyer   @map("Mid Range Buyer")
  PremiumBuyer    @map("Premium Buyer")
  LuxuryBuyer     @map("Luxury Buyer")
}

enum TechTier {
  Budget
  Reasonable
  FlagshipKiller @map("Flagship Killer")
  TechSavvy      @map("Tech Savvy")
  Luxurious
}

enum SegmentConfidence {
  provisional
  confirmed
}

// ============================================================
// Models — Auth / RBAC / Sessions
// ============================================================
model Roles {
  roleId   String  @id @default(uuid()) @map("role_id") @db.Uuid
  roleName String  @unique @map("role_name") @db.VarChar(50)
  users    Users[]

  @@map("roles")
}

model Users {
  name       String
  userId     String  @id @default(uuid()) @map("user_id") @db.Uuid
  email      String  @unique @db.VarChar(255)
  password   String  @db.VarChar(255)
  phoneNo    String? @unique @map("phone_no")
  isActive   Boolean @default(true) @map("is_active")
  isVerified Boolean @default(false) @map("is_verified")

  roleId String? @map("role_id") @db.Uuid
  role   Roles?  @relation(fields: [roleId], references: [roleId], onDelete: SetNull)

  otps Otp[]

  // Smartphone recommendation system relations
  profile               UserProfile?
  preference            UserPreference?
  customerProfile       CustomerProfile?
  recommendationHistory RecommendationHistory[]
  wishlist              Wishlist[]
  comparisonHistory     ComparisonHistory[]
  paymentHistory        PaymentHistory[]
  searchHistory         SearchHistory[]
  browsingHistory       BrowsingHistory[]

  // Step B — unified behaviour event log + per-tag behaviour score
  events         Event[]
  behaviorScores BehaviorScore[]

  // Step D — per-candidate impression log for the new fused ranker.
  // Feeds future customer-segmentation clustering (the popularity
  // signal reserved at 0.05 weight in FUSION_WEIGHTS).
  recommendationLogs RecommendationLog[]

  // Customer-segmentation + collaborative-filtering integration. The
  // CF FastAPI service (`ML Model/filtering/cf_service/`) consumes a
  // `customer_id` of the form `CUST-XXXXXXXX` (the format the original
  // customer_dataset.csv uses and the CF model was trained on). For
  // each application user, we either remember an explicit mapping from
  // their app `userId` to that `customerId` (e.g. CSV-imported users
  // whose email is `${customerId}@import.local`) or we fall back to a
  // cluster lookup at runtime. `CustomerCluster` is populated lazily
  // the first time the BE tries to look up the cluster for a user.
  customerCluster      CustomerCluster?
  cfRecommendationLogs CfRecommendationLog[]

  // One row per recommendation call — backs the "Last recommendation
  // → Top results" admin panel without re-running the ML pipeline.
  recommendationCalls RecommendationCall[]

  @@index([roleId])
  @@map("users")
}

model Otp {
  otpId     String     @id @default(uuid()) @map("otp_id") @db.Uuid
  code      String     @db.VarChar(6)
  userId    String     @map("user_id") @db.Uuid
  purpose   OtpPurpose @default(Registration) @map("purpose")
  expiresAt DateTime   @map("expires_at")
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, purpose, isUsed, expiresAt])
  @@map("otps")
}

model Session {
  sid    String   @id @map("sid") @db.VarChar
  sess   Json     @map("sess")
  expire DateTime @map("expire") @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ============================================================
// Normalized Phone Data Models
// ============================================================

// Brand master table
model Brands {
  brandId   String   @id @default(uuid()) @map("brand_id") @db.Uuid
  name      String   @unique @db.VarChar(60)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  website   String?  @db.VarChar(200)
  country   String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phones          Phones[]
  userPreferences UserPreference[]

  @@map("brands")
}

// Main phone model - each phone model (e.g., "Galaxy S24 Ultra")
model Phones {
  phoneId   String @id @default(uuid()) @map("phone_id") @db.Uuid
  brandId   String @map("brand_id") @db.Uuid
  modelName String @map("model_name") @db.VarChar(120)

  // Display image
  imageUrl  String? @map("image_url") @db.VarChar(500)
  imagePath String? @map("image_path") @db.VarChar(500)

  // Aggregated/derived fields for quick filtering
  antutuScore Int? @map("antutu_score") // Best score across all variants
  batteryMah  Int? @map("battery_mah") // From specs

  // Data provenance
  source    String? @db.VarChar(40) // e.g., "gsmarena", "admin", "api"
  sourceUrl String? @map("source_url") @db.VarChar(500) // Original page URL

  // Freshness / stock / trend — populated by nightly jobs. The
  // `stockState` column is the pre-fusion gate (#9): out-of-stock
  // phones are dropped from auto responses. `releasedAt` powers the
  // freshness sub-score; phones older than 18 months are
  // deprioritised but not dropped.
  releasedAt     DateTime? @map("released_at")
  stockState     String?   @map("stock_state") @db.VarChar(20) // "in_stock" | "low_stock" | "out_of_stock"
  stockUpdatedAt DateTime? @map("stock_updated_at")

  // Soft delete & lifecycle
  isActive       Boolean   @default(true) @map("is_active")
  discontinuedAt DateTime? @map("discontinued_at")
  createdAt      DateTime  @default(now()) @map("created_date")
  updatedAt      DateTime  @updatedAt @map("updated_date")

  // Relations
  brand    Brands          @relation(fields: [brandId], references: [brandId], onDelete: Cascade)
  variants PhoneVariants[]
  specs    PhoneSpecs?
  trend    PhoneTrend?

  // Recommendation relations
  recommendationHistory RecommendationHistory[]
  recommendationLogs    RecommendationLog[]
  wishlist              Wishlist[]
  comparedAsA           ComparisonHistory[]     @relation("ComparisonPhoneA")
  comparedAsB           ComparisonHistory[]     @relation("ComparisonPhoneB")

  // Admin stats cache back-relations (cache stores phoneId; relations are
  // nullable so hard-deletion of a phone does not cascade into historical
  // cache rows).
  mostRecommendedInStats AdminStatsCache[] @relation("MostRecommendedPhone")
  mostComparedInStats    AdminStatsCache[] @relation("MostComparedPhone")
  mostViewedInStats      AdminStatsCache[] @relation("MostViewedPhone")

  @@unique([brandId, modelName])
  @@index([brandId])
  @@index([antutuScore])
  @@index([isActive])
  @@map("phones")
}

// Phone variants - different RAM/Storage/Price combinations for each phone
model PhoneVariants {
  variantId String @id @default(uuid()) @map("variant_id") @db.Uuid
  phoneId   String @map("phone_id") @db.Uuid

  // Specifications that vary by variant
  ramGb       Int      @map("ram_gb")
  storageGb   Int      @map("storage_gb")
  price       Decimal? @db.Decimal(10, 2)
  storageType String?  @map("storage_type") @db.VarChar(20) // e.g., "UFS 3.1"

  // Color options (could be JSON array or separate table)
  colors Json? @db.Json // e.g., ["Black", "White", "Blue"]

  // Availability
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phone Phones @relation(fields: [phoneId], references: [phoneId], onDelete: Cascade)

  @@unique([phoneId, ramGb, storageGb])
  @@index([phoneId])
  @@index([price])
  @@map("phone_variants")
}

// Detailed phone specifications (1-to-1 with Phones)
model PhoneSpecs {
  specId  String @id @default(uuid()) @map("spec_id") @db.Uuid
  phoneId String @unique @map("phone_id") @db.Uuid

  // Network & Connectivity
  networkTech   String?  @map("network_technology") @db.VarChar(100)
  supports5g    Boolean  @default(false) @map("supports_5g")
  supportsNfc   Boolean  @default(false) @map("supports_nfc")
  dualSim       Boolean  @default(false) @map("dual_sim")
  simType       String?  @map("sim_type") @db.VarChar(50)
  wifi          String?  @db.VarChar(100)
  bluetooth     String?  @map("bluetooth_version") @db.VarChar(20)
  usbType       String?  @map("usb_type") @db.VarChar(50)
  headphoneJack Boolean? @map("headphone_jack")
  gps           Boolean  @default(true)
  sensors       Json?    @db.Json // Array of sensors: ["Accelerometer", "Gyro", "Proximity"]

  // Display
  displayType       String?  @map("display_type") @db.VarChar(50)
  refreshRate       Int?     @map("refresh_rate_hz")
  displaySize       Decimal? @map("display_size_inch") @db.Decimal(4, 2)
  resolution        String?  @db.VarChar(30) // e.g., "1080x2400"
  ppiDensity        Int?     @map("ppi_density")
  screenToBody      Decimal? @map("screen_to_body_pct") @db.Decimal(5, 2)
  displayProtection String?  @map("display_protection") @db.VarChar(100)

  // Platform
  os          String? @db.VarChar(40)
  osVersion   String? @map("os_version") @db.VarChar(40)
  chipset     String? @db.VarChar(100)
  processNode String? @map("process_node_nm") @db.VarChar(20) // e.g., "4nm"
  cpu         String? @db.VarChar(200)
  gpu         String? @db.VarChar(200)

  // Camera
  mainCamera   String?  @map("main_camera_mp") @db.VarChar(50) // "50MP + 12MP + 8MP"
  lensCount    Int?     @map("lens_count")
  mainAperture String?  @map("main_aperture") @db.VarChar(20)
  ois          Boolean? @default(false)
  sensorSize   String?  @map("sensor_size") @db.VarChar(50)
  camera4K     Boolean? @map("camera_4k_video")
  cameraVideo  String?  @map("camera_video") @db.VarChar(200)
  selfieCamera String?  @map("selfie_camera_mp") @db.VarChar(50)
  selfie4K     Boolean? @map("selfie_4k_video")

  // Physical
  dimensions    String?  @db.VarChar(100) // "163.2 x 76.8 x 8.6"
  weight        Decimal? @db.Decimal(6, 2)
  buildMaterial String?  @map("build_material") @db.VarChar(100) // e.g., "Glass front, aluminum frame"
  ipRating      String?  @map("ip_rating") @db.VarChar(10) // e.g., "IP68"

  // Battery
  batteryMah       Int?     @map("battery_mah")
  wiredCharging    Int?     @map("wired_charging_w")
  wirelessCharging Int?     @map("wireless_charging_w")
  reverseWireless  Boolean? @map("reverse_wireless_charging")

  // Metadata
  announced DateTime? @db.Date
  status    String?   @db.VarChar(50) // "Available", "Discontinued", "Upcoming"

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  phone Phones @relation(fields: [phoneId], references: [phoneId], onDelete: Cascade)

  @@index([supports5g])
  @@index([os])
  @@map("phone_specs")
}

// ============================================================
// User Profile & Preferences
// ============================================================

model UserProfile {
  profileId String   @id @default(uuid()) @map("profile_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  age       Int?     @db.SmallInt
  gender    String?  @db.VarChar(20)
  country   String?  @db.VarChar(80)
  state     String?  @db.VarChar(80)
  city      String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreference {
  preferenceId String @id @default(uuid()) @map("preference_id") @db.Uuid
  userId       String @unique @map("user_id") @db.Uuid

  maxBudget        Decimal          @map("max_budget") @db.Decimal(10, 2)
  cameraPreference CameraPreference @map("camera_preference")
  usageType        UsageType        @map("usage_type")

  // FK to Brands. Nullable so a user can submit the questionnaire before the
  // Brands table is fully seeded, or skip the brand question. The questionnaire
  // UI is responsible for not submitting a brand name that isn't in `Brands`.
  preferredBrandId String? @map("preferred_brand_id") @db.Uuid
  preferredBrand   Brands? @relation(fields: [preferredBrandId], references: [brandId], onDelete: SetNull)

  // Multiple preferred brand names accumulated from CSV imports or
  // questionnaire iterations. Stored as a JSON array of unique strings
  // (e.g. ["Apple", "Samsung", "Google"]). `preferredBrandId` above
  // remains the FK-resolution for the primary brand; this list preserves
  // the full set.
  preferredBrands Json? @map("preferred_brands") @db.JsonB

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([preferredBrandId])
  @@map("user_preferences")
}

// ============================================================
// Recommendation & Analytics
// ============================================================

model RecommendationHistory {
  historyId  String   @id @default(uuid()) @map("history_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneId    String   @map("phone_id") @db.Uuid
  searchDate DateTime @default(now()) @map("search_date")

  queryId     String? @map("query_id") @db.Uuid
  filtersJson Json?   @map("filters_json")

  performanceMatch     Decimal? @map("performance_match") @db.Decimal(5, 2)
  cameraMatch          Decimal? @map("camera_match") @db.Decimal(5, 2)
  batteryMatch         Decimal? @map("battery_match") @db.Decimal(5, 2)
  displayMatch         Decimal? @map("display_match") @db.Decimal(5, 2)
  budgetMatch          Decimal? @map("budget_match") @db.Decimal(5, 2)
  brandMatch           Decimal? @map("brand_match") @db.Decimal(5, 2)
  overallCompatibility Decimal? @map("overall_compatibility") @db.Decimal(5, 2)

  personaSnapshot String? @map("persona_snapshot") @db.VarChar(60)

  clicked   Boolean @default(false)
  compared  Boolean @default(false)
  saved     Boolean @default(false)
  purchased Boolean @default(false)

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  @@index([userId, searchDate(sort: Desc)])
  @@index([phoneId])
  @@index([queryId])
  @@map("recommendation_history")
}

// Step D — per-candidate impression log. One row per served candidate
// (rank + finalScore + userId + phoneId + source + requestId). The
// dashboard auto-recommendation flow now also writes here so the
// learned-fusion-weights trainer (#3) has data to fit on.
//
// Extensions over the v1 schema:
//   - `source`       discriminates "auto" / "click" / "similar" so
//                    training data can pick the right stream and we
//                    never double-count a phone across call origins.
//   - `requestId`    is a UUID minted by the FE per dashboard mount.
//                    Lets the FE upsert dwell/skip/click via the
//                    `impression_unique` key without producing N rows
//                    on every scroll event.
//   - `dwellMs`      is the max viewport-dwell the FE has observed
//                    for this impression. 0 = below the fold and
//                    never scrolled to.
//   - `clicked` / `skipped` are escalated-only booleans (set true
//                    once and never reset). A scroll past without a
//                    click flips `skipped` so the trainer can
//                    distinguish "showed, ignored" from "showed, not
//                    visible long enough to judge".
//   - `isTrainingEligible` is computed by the FE based on dwell + skip
//                    state. The trainer filters on this column so
//                    auto-load impressions that the user never saw
//                    don't pollute the regression.
//
// Note: the v1 (userId, phoneId, source, requestId) UNIQUE constraint
// is what lets the FE's `POST /impressions` endpoint be a true
// upsert — multiple dwell deltas in a session collapse to one row.
model RecommendationLog {
  logId                 String    @id @default(uuid()) @map("log_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  phoneId               String    @map("phone_id") @db.Uuid
  finalScore            Float     @map("final_score")
  rank                  Int
  source                String    @default("click") @map("source") @db.VarChar(20)
  requestId             String?   @map("request_id") @db.Uuid
  dwellMs               Int       @default(0) @map("dwell_ms")
  clicked               Boolean   @default(false)
  skipped               Boolean   @default(false) @map("skipped")
  isTrainingEligible    Boolean   @default(false) @map("is_training_eligible")
  explorationArm        String?   @map("exploration_arm") @db.VarChar(40)
  shownAt               DateTime  @default(now()) @map("shown_at")
  firstSeenAt           DateTime? @map("first_seen_at")
  // AUTO-rec instrumentation. Defaults to "legacy_v0" so existing
  // POST callers (which never set this) keep byte-identical output.
  // The new multi-retriever orchestrator writes either "legacy_v0"
  // (rollout-bucketed into the legacy path) or "multi_retriever_v1"
  // (served from the new orchestrator). FE /impressions upsert is a
  // label-only update (dwell/click/skip) — this column is never
  // overwritten by the FE path.
  recommendationVersion String?   @default("legacy_v0") @map("recommendation_version") @db.VarChar(32)

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  // Lets the FE upsert dwell/skip/click on a single row per session.
  @@unique([userId, phoneId, source, requestId], name: "impression_unique", map: "impression_unique_idx")
  @@index([userId, shownAt(sort: Desc)])
  @@index([phoneId])
  @@index([isTrainingEligible, shownAt(sort: Desc)], map: "training_eligible_idx")
  // Powers the legacy vs multi-retriever comparison metric (every
  // impression is tagged with `recommendation_version`).
  @@index([recommendationVersion, shownAt(sort: Desc)], map: "recommendation_version_idx")
  @@map("recommendation_logs")
}

// One row per *recommendation call* (not per phone). The `topResults`
// JSON column carries up to 3 phoneIds ranked by `matchScore` so the
// admin "Last recommendation → Top results" panel can show the
// human-readable brand · model for that exact call without fanning
// out into the per-phone RecommendationHistory table.
model RecommendationCall {
  callId     String   @id @default(uuid()) @map("call_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  persona    String?  @map("persona") @db.VarChar(60)
  budget     Json?    @map("budget") @db.JsonB
  topResults Json?    @map("top_results") @db.JsonB // [{ phoneId, modelName, brand, rank, score }]
  servedAt   DateTime @default(now()) @map("served_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, servedAt(sort: Desc)])
  @@map("recommendation_calls")
}

// PhoneTrend — nightly-job populated, 0..1 normalised score. Powers
// the `freshness_trending` slot in FUSION_WEIGHTS (#9). Trending
// alone creates a rich-get-richer feedback loop, so the score is
// computed as (clicks_7d / impressions_7d) vs. the prior 7d — a
// positive trend = the phone is becoming MORE clicked, not just more
// seen.
model PhoneTrend {
  phoneId       String   @id @map("phone_id") @db.Uuid
  trendScore    Float    @default(0) @map("trend_score")
  views7d       Int      @default(0) @map("views_7d")
  clicks7d      Int      @default(0) @map("clicks_7d")
  impressions7d Int      @default(0) @map("impressions_7d")
  updatedAt     DateTime @updatedAt @map("updated_at")

  phone Phones @relation(fields: [phoneId], references: [phoneId], onDelete: Cascade)

  @@index([trendScore(sort: Desc)])
  @@map("phone_trends")
}

// Training impressions — one row per qualified impression (#3). The
// learned-fusion-weights trainer reads from this view, NOT from
// recommendation_logs, so the data can be cleaned (deduped by
// (userId, phoneId, requestId), filtered by observation window,
// position-dampened) in a single scheduled job rather than at every
// read.
//
// The view is intentionally a denormalised flat table: each row is
// the input feature vector for one ranking decision plus its outcome
// (click, dwell, skip, purchase). The trainer produces per-feature
// weights that the BE loads as FUSION_WEIGHTS.
model TrainingImpression {
  impressionId  String @id @default(uuid()) @map("impression_id") @db.Uuid
  requestId     String @map("request_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  phoneId       String @map("phone_id") @db.Uuid
  source        String @map("source") @db.VarChar(20)
  position      Int    @map("position")
  viewportIndex Int?   @map("viewport_index")

  // Sub-scores (5 + optional 6th)
  sCompatibility   Float    @map("s_compatibility")
  sCustomerPref    Float    @map("s_customer_pref")
  sContentSim      Float    @map("s_content_sim")
  sSearchHistory   Float    @map("s_search_history")
  sValue           Float    @map("s_value")
  sFreshness       Float?   @map("s_freshness")
  inStock          Boolean? @map("in_stock")
  daysSinceRelease Int?     @map("days_since_release")

  // Context
  userPersona String? @map("user_persona") @db.VarChar(40)
  userSegment String? @map("user_segment") @db.VarChar(40)
  hasHistory  Boolean @map("has_history")

  // Labels (one hot)
  labelClicked     Boolean?  @map("label_clicked")
  labelClickedAt   DateTime? @map("label_clicked_at")
  labelDwellMs     Int?      @map("label_dwell_ms")
  labelSkipped     Boolean?  @map("label_skipped")
  labelPurchased   Boolean?  @map("label_purchased")
  labelPurchasedAt DateTime? @map("label_purchased_at")

  // Eligibility — must be true for the row to enter training
  isTrainingEligible Boolean @map("is_training_eligible")

  observedAt DateTime  @map("observed_at")
  labelledAt DateTime? @map("labelled_at")

  @@index([observedAt(sort: Desc)])
  @@index([userId, phoneId])
  @@index([isTrainingEligible, labelClicked], map: "train_eligible_clicked_idx")
  @@map("training_impressions")
}

model CustomerProfile {
  profileId String @id @default(uuid()) @map("profile_id") @db.Uuid
  userId    String @unique @map("user_id") @db.Uuid

  budgetSegment    BudgetSegment?    @map("budget_segment")
  techTier         TechTier?         @map("tech_tier")
  cameraPreference CameraPreference? @map("camera_preference")
  softwareSegment  String?           @map("software_segment") @db.VarChar(40)

  favoriteBrand      String? @map("favorite_brand") @db.VarChar(60)
  preferredRamGb     Int?    @map("preferred_ram_gb")
  preferredStorageGb Int?    @map("preferred_storage_gb")

  recommendationPersona String? @map("recommendation_persona") @db.VarChar(60)

  // Internal running state
  avgPerformanceMatch Decimal? @map("avg_performance_match") @db.Decimal(5, 2)
  avgCameraMatch      Decimal? @map("avg_camera_match") @db.Decimal(5, 2)
  avgFrontCameraMatch Decimal? @map("avg_front_camera_match") @db.Decimal(5, 2)
  avgBudget           Decimal? @map("avg_budget") @db.Decimal(10, 2)
  avgBatteryMatch     Decimal? @map("avg_battery_match") @db.Decimal(5, 2)
  avgDisplayMatch     Decimal? @map("avg_display_match") @db.Decimal(5, 2)

  segmentConfidence SegmentConfidence @default(provisional) @map("segment_confidence")
  searchCount       Int               @default(0) @map("search_count")

  totalRecommendations Int @default(0) @map("total_recommendations")
  totalComparisons     Int @default(0) @map("total_comparisons")
  totalWishlist        Int @default(0) @map("total_wishlist")

  lastUpdated      DateTime  @updatedAt @map("last_updated")
  // Watermark for the modal aggregator (profileAggregator.mjs). Distinct
  // from `lastUpdated` because `lastUpdated` is auto-bumped on every
  // write (searchCount increments, persona changes, etc.), but the
  // aggregator only ticks when MIN_NEW_ROWS new recommendation rows
  // have come in. Using a separate column keeps the throttle cheap —
  // a single field comparison, not a count + ORDER BY.
  lastAggregatedAt DateTime? @map("last_aggregated_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("customer_profile")
}

model Wishlist {
  wishlistId String   @id @default(uuid()) @map("wishlist_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  phoneId    String   @map("phone_id") @db.Uuid
  addedDate  DateTime @default(now()) @map("added_date")

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phone Phones @relation(fields: [phoneId], references: [phoneId])

  @@unique([userId, phoneId])
  @@map("wishlist")
}

model ComparisonHistory {
  comparisonId String   @id @default(uuid()) @map("comparison_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  phoneIdA     String   @map("phone_id_a") @db.Uuid
  phoneIdB     String   @map("phone_id_b") @db.Uuid
  comparedDate DateTime @default(now()) @map("compared_date")

  user   Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  phoneA Phones @relation("ComparisonPhoneA", fields: [phoneIdA], references: [phoneId])
  phoneB Phones @relation("ComparisonPhoneB", fields: [phoneIdB], references: [phoneId])

  @@index([userId, comparedDate(sort: Desc)])
  @@map("comparison_history")
}

// ============================================================
// Payment History (per-purchase records from CSV imports)
// ============================================================

// One row per purchase event from external data sources
// (e.g. customer_dataset.csv). Not tied to the normalized phone
// catalog by FK — phones referenced here may not exist in the
// catalog. `phoneLabel` preserves the human-readable name as it
// appeared in the source for audit purposes.
model PaymentHistory {
  paymentId         String    @id @default(uuid()) @map("payment_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  purchaseDate      DateTime? @map("purchase_date") @db.Date
  purchaseAmountNpr Decimal?  @map("purchase_amount_npr") @db.Decimal(12, 2)
  paymentMethod     String?   @map("payment_method") @db.VarChar(60)
  warrantyOpted     String?   @map("warranty_opted") @db.VarChar(40)
  exchangeHistory   Json?     @map("exchange_history") @db.JsonB
  phoneLabel        String?   @map("phone_label") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, purchaseDate(sort: Desc)])
  @@index([purchaseDate])
  @@map("payment_history")
}

// ============================================================
// Search History (per-search records from CSV imports)
// ============================================================

// One row per search event from external data sources. Not tied to the
// catalog by FK — `searchQuery` is the raw CSV value, which can be a brand
// name, a category tag, "Comparison", "New Arrivals", etc.
model SearchHistory {
  searchId    String    @id @default(uuid()) @map("search_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  searchQuery String    @map("search_query") @db.VarChar(200)
  searchedAt  DateTime? @map("searched_at") @db.Timestamp(6)
  sourceLine  Int?      @map("source_line")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
  @@index([searchedAt])
  @@map("search_history")
}

// ============================================================
// Browsing History (per-viewed-item records from CSV imports)
// ============================================================

// One row per viewed item from external data sources. Intentionally NOT
// linked to `Phones` by FK — the source contains fictional / future /
// discontinued / tablet entries that don't exist in the catalog. The raw
// label is preserved verbatim for downstream analytics.
//
// `phoneId` is a non-FK pointer written when the caller does have a
// known Phones row. It is used by the dedup gate in
// `safeRecordBrowseEvent` to recognise an already-tracked phone across
// label renames (e.g. when the catalog adds a new variant of the same
// model). The existing rows had `phoneId = null`; the dedup falls back
// to `phoneLabel` for those.
model BrowsingHistory {
  browsingId String    @id @default(uuid()) @map("browsing_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  phoneLabel String    @map("phone_label") @db.VarChar(200)
  phoneId    String?   @map("phone_id") @db.Uuid
  brandName  String?   @map("brand_name") @db.VarChar(60)
  viewedAt   DateTime? @map("viewed_at") @db.Timestamp(6)
  sourceLine Int?      @map("source_line")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([userId, phoneId])
  @@index([viewedAt])
  @@map("browsing_history")
}

model AdminStatsCache {
  statId               String   @id @default(uuid()) @map("stat_id") @db.Uuid
  computedDate         DateTime @default(now()) @map("computed_date")
  mostRecommendedBrand String?  @map("most_recommended_brand") @db.VarChar(60)

  // FKs into Phones (nullable — the cache row is "as-of computedDate";
  // the phone may have been hard-removed later, and the cache should still
  // display the historical snapshot).
  mostRecommendedPhoneId String? @map("most_recommended_phone_id") @db.Uuid
  mostComparedPhoneId    String? @map("most_compared_phone_id") @db.Uuid
  mostViewedPhoneId      String? @map("most_viewed_phone_id") @db.Uuid

  avgUserBudget      Decimal? @map("avg_user_budget") @db.Decimal(10, 2)
  mostPopularPersona String?  @map("most_popular_persona") @db.VarChar(60)
  avgCompatibility   Decimal? @map("avg_compatibility") @db.Decimal(5, 2)

  // Relations — back-relation only. The Phone→AdminStatsCache FK is intentionally
  // NOT modeled (admin cache is a denormalized snapshot, not a hot FK). The cache
  // row stores the phoneId; the consumer joins on `Phones.phoneId` at read time.
  mostRecommendedPhone Phones? @relation("MostRecommendedPhone", fields: [mostRecommendedPhoneId], references: [phoneId], onDelete: SetNull)
  mostComparedPhone    Phones? @relation("MostComparedPhone", fields: [mostComparedPhoneId], references: [phoneId], onDelete: SetNull)
  mostViewedPhone      Phones? @relation("MostViewedPhone", fields: [mostViewedPhoneId], references: [phoneId], onDelete: SetNull)

  @@index([computedDate(sort: Desc)])
  @@map("admin_stats_cache")
}

// ============================================================
// Step B — Unified Event Log + Per-Tag Behaviour Scores
// ============================================================
//
// `Event` is the single source of truth for every user interaction. The
// legacy Step A tables (SearchHistory / BrowsingHistory /
// RecommendationHistory / ComparisonHistory) remain so the existing
// admin UI keeps working — controllers write to BOTH (`bridge` pattern).
//
// `BehaviorScore` rolls per-tag deltas from every event into a single
// exponentially-decayed score. Step C (Profile Fusion) and Step D
// (Ranking) will read from this table.

model Event {
  eventId   String   @id @default(uuid()) @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(40) // search | view | compare | click | save | ignore | recommend
  phoneId   String?  @map("phone_id") @db.Uuid
  payload   Json?    @map("payload") // free-form context: {q:"ROG"} | {modelNameA,modelNameB} | {filters:{...}}
  createdAt DateTime @default(now()) @map("created_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType])
  @@index([userId, eventType, phoneId, createdAt(sort: Desc)])
  @@map("events")
}

model BehaviorScore {
  userId    String   @map("user_id") @db.Uuid
  tag       String   @db.VarChar(60) // e.g. "gaming", "camera", "battery", "brand:Samsung", "tier:flagship", "feature:gaming", "feature:camera"
  score     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  // Recent-reason tracker (Phase 6 — explainability). Newer events
  // land at the head of the LRU; the oldest is evicted when the
  // array exceeds `BEHAVIOR_CONFIG.reasons.perTagLimit` (default 5).
  // Shape is documented in services/behaviorAnalyzer.mjs.
  reasons   Json?    @map("reasons")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, tag])
  @@index([userId])
  @@map("behavior_scores")
}

// ============================================================
// Customer Segmentation + Collaborative Filtering
//
// Two tables added by the CF integration migration:
//
//   CustomerCluster       — links an app user to a KMeans cluster
//                           (and human-readable cluster name) assigned
//                           by the segmentation model. Populated lazily
//                           on first CF / cluster lookup. Cluster ID
//                           matches the labels produced by the trained
//                           `kmeans_model.joblib` (0..3 — see
//                           `ML Model/filtering/02_segmentation/output/
//                            cluster_profiles.csv` for names).
//
//   CfRecommendationLog   — one row per served CF recommendation
//                           call. Used for offline analytics / debugging
//                           and for telling the "this phone was
//                           suggested because of CF" story in admin
//                           tooling. Distinct from `RecommendationLog`
//                           (which tracks the full hybrid top-N) —
//                           this table only carries the CF top-N
//                           alongside the cold-start flag and the
//                           human-readable reason strings.
// ============================================================

model CustomerCluster {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  // Cluster ID in the trained KMeans model's label space (0..3 for k=4).
  clusterId    Int      @map("cluster_id")
  // Human-readable cluster name from
  // `cluster_profiles.csv` (e.g. "Premium Flagship Shopper",
  // "Mainstream Mid-Range Shopper", "Hardcore Gamer (Flagship)",
  // "Budget Buyer"). Cached here so the FE doesn't need to round-trip
  // through the segmentation CSV on every dashboard mount.
  clusterName  String   @map("cluster_name") @db.VarChar(80)
  // Optional mapping back to the CF dataset's customer_id format. For
  // users imported from `customer_dataset.csv` this equals the
  // `${customerId}@import.local` email prefix. For real registrations
  // (no CF counterpart), this stays null and the CF service falls back
  // to global popularity.
  cfCustomerId String?  @map("cf_customer_id") @db.VarChar(40)
  assignedAt   DateTime @default(now()) @map("assigned_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([clusterId])
  @@map("customer_clusters")
}

model CfRecommendationLog {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  // The CF dataset's customer_id format (e.g. CUST-000EFD69) that was
  // used to call the CF service. Null for users that don't have a CF
  // counterpart (real registrations) — the CF service is still called
  // with a synthetic id and the model falls back to global popularity.
  cfCustomerId String?  @map("cf_customer_id") @db.VarChar(40)
  // `isColdStart` mirrors the `cold_start` field in the CF service
  // response: true when the user was unknown to the CF model and the
  // cluster/province/global popularity chain kicked in.
  isColdStart  Boolean  @default(false) @map("is_cold_start")
  // The CF service returned N phones; we JSON-store the
  // model_name / score / reason tuples as one column so analytics
  // can replay the served list without re-running the model.
  modelNames   String   @map("model_names") @db.Text
  scores       String   @map("scores") @db.Text
  reasons      String   @map("reasons") @db.Text
  servedAt     DateTime @default(now()) @map("served_at")

  user Users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, servedAt(sort: Desc)])
  @@map("cf_recommendation_logs")
}

// ============================================================
// Notes:
//
// 1. This schema normalizes phone data into:
//    - Brands: Master brand list
//    - Phones: Each phone model (unique by brand + modelName)
//    - PhoneVariants: RAM/Storage/Price combinations
//    - PhoneSpecs: Detailed specifications (1-to-1 with Phones)
//
// 2. Data Import Example:
//    Insert brand → Insert phone → Insert variants → Insert specs
//
// 3. For filtering by variant attributes (RAM, storage, price):
//    Query PhoneVariants with conditions and join to Phones
//
// 4. For phone listings that show "from $X" pricing:
//    SELECT MIN(price) FROM phone_variants WHERE phone_id = ?
//
// 5. Common queries:
//    - "Find phones with 5G and 8GB+ RAM": Join phones → specs (5G) and variants (RAM)
//    - "Find phones under $800": Filter variants by price, get unique phones
//    - "Best camera phones": Sort by cameraScore in specs
//
// 6. Customer CSV Import:
//    - Users created with `${customer_id}@import.local` placeholder email
//    - One PaymentHistory row per CSV purchase event
//    - Wishlist rows created ONLY against existing Brands + Phones
//      (CSV-driven wishlist items referencing unknown brands/phones are skipped)
//    - UserPreference.preferredBrands preserves the full unique set of
//      preferred brand names found across the customer's history
// ============================================================
