# ─────────────────────────────────────────────────────────────────────────────
# Backend — runtime environment template
#
# Copy to `backend/.env` for local development (NOT for Docker — Docker
# injects these via docker-compose.yml / the platform's env UI).
#
# In Docker, all variables below marked [compose] are OVERRIDDEN by
# docker-compose.yml. The values here are only used when running the
# backend directly on the host (e.g. `npm run dev` outside of Docker).
#
# NEVER commit `backend/.env` to git — it is .gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8001
# `production` triggers NODE_ENV=production behaviour in Express (no
# verbose errors, trust proxy headers, etc.). `development` for local.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# [compose] Inside Docker, DATABASE_URL is overridden by compose to point
# at the `postgres` service. The value below is for host-only local dev.
#
# Prisma 7 uses the URL here AT BUILD TIME for `prisma generate` and at
# runtime for queries. In production, set this to your managed DB URL.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mobile_recommender?schema=public

# ── Session ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# [compose] Inside Docker, COOKIE_SECRET is overridden by compose (or read
# from root .env). The value below is the dev fallback.
#
# Production: this value must be stable across all backend replicas,
# otherwise sessions are invalidated on every redeploy.
COOKIE_SECRET=replace-me-with-openssl-rand-hex-32

# ── ML / CF services ────────────────────────────────────────────────────────
# [compose] Inside Docker, both are overridden by compose to the internal
# service names. The values below are for host-only local dev.
#
# Production: set to the public/private URLs your platform exposes for
# these services. If using a single VPS, set to the local docker network
# URLs (e.g. http://ml-service:8002).
ML_BASE_URL=http://127.0.0.1:8002
CF_BASE_URL=http://127.0.0.1:9001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Defaults to the Vite
# dev port (5173) and the production-served port (8080) so both modes
# work without CORS errors.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
# Used by nodemailer for OTP / password reset emails. Generate a Gmail
# app password at https://myaccount.google.com/apppasswords — do NOT
# use your real Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password
