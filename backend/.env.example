# ─────────────────────────────────────────────────────────────────────────────
# Backend — runtime environment template
#
# Copy this file to `backend/.env` and fill in real values for local dev.
# In Docker, the variables below marked with [compose] are ALSO injected by
# docker-compose.yml; the values here are only used when running the backend
# directly on the host (e.g., `npm run dev` outside of Docker).
#
# NEVER commit `backend/.env` to git. It is already covered by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=8001
NODE_ENV=development

# --- Database ---
# [compose] Inside Docker, DATABASE_URL is overridden by compose to point at
# the `postgres` service. The value below is for host-only local dev.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mobile_recommender?schema=public

# --- Session ---
# Generate a real one with: `openssl rand -hex 32`
# [compose] Inside Docker, COOKIE_SECRET is overridden by compose (or read
# from root .env via ${COOKIE_SECRET}). The value below is the dev fallback.
COOKIE_SECRET=270953d1e377bb9e16dfb4dbbe15e362f89aa92e0065f7e1c43f0a135cad97c2

# --- ML service ---
# [compose] Inside Docker, ML_BASE_URL is overridden by compose to the
# internal service name. The value below is for host-only local dev.
ML_BASE_URL=http://127.0.0.1:8002

# --- CORS ---
# Comma-separated list of allowed origins for the browser-facing API.
CORS_ORIGIN=http://localhost:5173

# --- Mail (SMTP) ---
# Used by nodemailer for OTP delivery / password reset emails.
# Generate a Gmail app password at https://myaccount.google.com/apppasswords
# (do NOT use your real Gmail password).
SMTP_PASS=kzpqluhrlnfzwszx
SMTP_USER=aayushchhuka7@gmail.com
SMTP_HOST=smtp.gmail.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mobile_recommender
