# ─────────────────────────────────────────────────────────────────────────────
# Root — Docker Compose environment template
#
# Copy this file to `.env` (in the repo root) and fill in real values before
# running `docker compose up`. Compose reads these via ${VAR} / ${VAR:-default}
# substitution.
#
# NEVER commit the real `.env` to git. It is already covered by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (used by the `postgres` service) ---
# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mobile_recommender

# Backend
COOKIE_SECRET=your_random_cookie_secret

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
