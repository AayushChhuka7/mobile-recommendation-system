# ─────────────────────────────────────────────────────────────────────────────
# Root — Docker Compose environment template
#
# Copy this file to `.env` (in the repo root) and fill in real values before
# running `docker compose --profile dev up --build`.
#
# This file is read by docker-compose.yml via ${VAR} / ${VAR:-default}
# substitution. NEVER commit the real `.env` to git (it is .gitignored).
#
# For PRODUCTION deployments (Render / Railway / Fly.io / VPS), the
# equivalent values are set in your platform's environment-variable UI
# (or .env file on the host) — NOT inside this repo.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────── PostgreSQL (local dev only — production uses a managed DB) ─────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mobile_recommender

# ─────────── Cookie / session signing key ────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
# This MUST be set; the compose file uses ${COOKIE_SECRET:?...} which fails
# loudly if it is missing or empty. The same value MUST be shared across
# every backend replica (otherwise sessions are invalidated on redeploy).
COOKIE_SECRET=your_random_cookie_secret

# ─────────── Gmail SMTP (optional in dev, required for OTP / reset emails) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ─────────── Backend CORS / public URLs ─────────────────────────────────────
# Comma-separated origins the backend will accept browser requests from.
# Production: set this to your deployed frontend domain(s).
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ─────────── Database URL (overrides the built-in local-dev URL) ───────────
# Leave UNSET for local dev — compose will use the postgres service URL.
# SET for production to your managed Postgres connection string:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Examples:
#   DATABASE_URL=postgresql://user:pw@db.example.com:5432/prod?schema=public
# DATABASE_URL=

# ─────────── Public API URL (frontend build-time variable) ──────────────────
# Used by the React build (VITE_API_URL). In production, this is the URL
# the BROWSER uses to reach the backend — set it to your public backend.
# Local dev default is fine for docker compose up.
VITE_API_URL=http://localhost:8001/api
