# ─────────────────────────────────────────────────────────────────────────────
# Mobile Recommendation & Segmentation System — root .gitignore
# Applies to the whole monorepo (backend + frontend + ml + dataset).
# Per-package ignores live in backend/.gitignore, frontend/.gitignore, etc.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & local environment ─────────────────────────────────────────────
# Never commit real credentials, tokens, or connection strings.
# Use the matching .env.example to document required variables.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Common editor / OS / tool state
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

backend/docs
backend/node_modules
backend/CLAUDE.md

# ── Claude ──────────────────────────────────────────────────────────────────
.claude
backend/.claude
backend/CLAUDE_CONTEXT.md

# ── Tooling caches ──────────────────────────────────────────────────────────
.eslintcache
.cache/
.parcel-cache/

# ── Local data & uploads ────────────────────────────────────────────────────
uploads/
tmp/
*.local
prompt.txt

ML Model/.venv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
ML Model/similarity_bundle.joblib


# ── ML model artifacts ──────────────────────────────────────────────────────
# joblib files are generated artifacts from training/serving scripts in
# `ML Model/`. They are large, binary, and reproducible from the source
# notebooks + datasets, so we never commit them. Trainers re-run on every push.
*.joblib
**/*.joblib
# Pickled sklearn objects (same reasoning as .joblib)
*.pkl
**/*.pkl
!ML Model/.venv/**/*.pkl
!ML Model/.venv/**/*.joblib
ML Model/similarity_bundle.joblib
