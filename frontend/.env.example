# ─────────────────────────────────────────────────────────────────────────────
# Frontend — runtime environment template
#
# Copy to `frontend/.env` for local development (NOT for Docker — the
# Dockerfile injects VITE_API_URL at BUILD time via the --build-arg).
#
# Vite reads `import.meta.env.VITE_*` at BUILD time and inlines the
# values into the JS bundle. They are NOT runtime-readable.
# ─────────────────────────────────────────────────────────────────────────────

# Public API URL — what the BROWSER uses to reach the backend.
#
# Local dev (docker compose up):
#   VITE_API_URL=http://localhost:8001/api
#
# Production (Render / Railway / Fly.io / custom VPS):
#   VITE_API_URL=https://api.your-domain.com/api
#
# In Docker, override the build arg via compose:
#   VITE_API_URL=https://api.example.com/api docker compose build frontend
#
# The /api suffix matters — the backend mounts everything under /api
# (see backend/src/index.mjs: `app.use("/api", router)`).
VITE_API_URL=http://localhost:8001/api
